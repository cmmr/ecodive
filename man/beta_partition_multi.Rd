\details{
With \eqn{N} samples, \eqn{S_i} the number of features of sample
\eqn{i}, \eqn{S_T} the number of features of all the samples together,
and \eqn{b_{ij}} the number of features in sample \eqn{i} but not in
sample \eqn{j}, Baselga (2010, 2012) defines, with sums over the pairs
\eqn{i < j}:
\itemize{
\item \eqn{\beta_{SOR} = \frac{\sum \min(b_{ij}, b_{ji}) + \sum \max(b_{ij}, b_{ji})}{2(\sum_i S_i - S_T) + \sum \min(b_{ij}, b_{ji}) + \sum \max(b_{ij}, b_{ji})}}
\item \eqn{\beta_{SIM} = \frac{\sum \min(b_{ij}, b_{ji})}{\sum_i S_i - S_T + \sum \min(b_{ij}, b_{ji})}}, and \eqn{\beta_{SNE} = \beta_{SOR} - \beta_{SIM}}
\item \eqn{\beta_{JAC} = \frac{\sum \min(b_{ij}, b_{ji}) + \sum \max(b_{ij}, b_{ji})}{\sum_i S_i - S_T + \sum \min(b_{ij}, b_{ji}) + \sum \max(b_{ij}, b_{ji})}}
\item \eqn{\beta_{JTU} = \frac{2 \sum \min(b_{ij}, b_{ji})}{\sum_i S_i - S_T + 2 \sum \min(b_{ij}, b_{ji})}}, and \eqn{\beta_{JNE} = \beta_{JAC} - \beta_{JTU}}
}

