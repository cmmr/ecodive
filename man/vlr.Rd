    x <- replace_zeros(ex_counts, 'mult')
    vlr(x)

    # The same as the variance of each log ratio
    var(log(x[, 'Streptococcus'] / x[, 'Bacteroides']))

    # Cluster the features
    plot(hclust(vlr(x)))

}
